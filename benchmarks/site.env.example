# Site settings of the comparison kit: copy this file to site.env in the
# directory of each stage (see docs/reproduce.md, "Layout on the host") and
# fill it in. Every kit job sources the site.env of its stage.

# the root of everything the evaluation writes (stages, stores, logs, images)
export GNOMON_BENCH_ROOT=/path/to/bench
# this stage's directory and its clone of the repository (built in place)
export EXTCMP_PROJECT=$GNOMON_BENCH_ROOT/final/w1
export EXTCMP_REPO=$EXTCMP_PROJECT/src
export KIT=$EXTCMP_REPO/benchmarks/compare/kit
export PYTHONPATH=$EXTCMP_REPO:$EXTCMP_REPO/scripts

# the engine build the stage runs: the commit, and the sha256 of the built
# extension (sha256sum $EXTCMP_REPO/gnomon/_engine*.so); the stage guard
# refuses any other build. EXTCMP_KITHEAD pins the kit code (default HEAD).
export EXTCMP_ENGINE_COMMIT=<commit>
export EXTCMP_ENGINE_SO_SHA256=<sha256 of gnomon/_engine*.so>
# export EXTCMP_KITHEAD=<commit>

# servers: docker on one machine, apptainer on a cluster (images under SIF_DIR)
export EXTCMP_BACKEND=apptainer
export SIF_DIR=$GNOMON_BENCH_ROOT/sif
export EXTCMP_JOB_SAFE=1

# Slurm: the account and the partitions of the three node classes the jobs
# use (slurm/stages.tsv: shared, whole, bigmem). Whole-node jobs ask for
# --exclusive and 128 tasks, as on the evaluation host (two 64-core CPUs).
export SBATCH_ACCOUNT=<account>
export SBATCH_PARTITION_SHARED=<partition for partial nodes>
export SBATCH_PARTITION_WHOLE=<partition for whole nodes>
export SBATCH_PARTITION_BIGMEM=<partition for large-memory nodes>
# node-local scratch (defaults to $TMPDIR, then /tmp, when the scheduler sets none)
# export LOCAL=/local/scratch

# client and server on separate NUMA nodes (the evaluation host had two)
export EXTCMP_NUMA_CLIENT="numactl --cpunodebind=0 --membind=0"
export EXTCMP_NUMA_SERVER="numactl --cpunodebind=1 --preferred=1"
export EXTCMP_DUCKDBSQL_THREADS=64

# tools: uv (the W4 transform's Python 3.8 environment), Java 8 (FinBench datagen)
# export UV=/path/to/uv
# export JAVA_HOME=/usr/lib/jvm/java-1.8.0
