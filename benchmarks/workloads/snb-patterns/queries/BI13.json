{
 "row": "BI13",
 "store": "snb_shaped",
 "calls": [
  {
   "pattern": {
    "nodes": [
     {
      "var": "p",
      "labels": [
       "Person"
      ]
     },
     {
      "var": "ci",
      "labels": [
       "City"
      ]
     },
     {
      "var": "cn",
      "labels": [
       "Country"
      ]
     }
    ],
    "steps": [
     {
      "from": "p",
      "to": "ci",
      "rel_type": "IS_LOCATED_IN",
      "dir": "out"
     },
     {
      "from": "ci",
      "to": "cn",
      "rel_type": "IS_PART_OF",
      "dir": "out"
     }
    ],
    "where": [
     {
      "cmp": "=",
      "l": {
       "tprop": [
        "cn",
        "name"
       ],
       "tau": "str"
      },
      "r": {
       "lit": "$country"
      }
     },
     {
      "cmp": "<",
      "l": {
       "col": "p.vt_s"
      },
      "r": {
       "lit": "$endDate",
       "tau": "ts"
      }
     }
    ],
    "optional": [
     {
      "nodes": [
       {
        "var": "m",
        "labels": [
         "Post",
         "Comment"
        ]
       }
      ],
      "steps": [
       {
        "from": "m",
        "to": "p",
        "rel_type": "HAS_CREATOR",
        "dir": "out"
       }
      ],
      "where": [
       {
        "cmp": "<=",
        "l": {
         "col": "m.vt_s"
        },
        "r": {
         "lit": "$endDate",
         "tau": "ts"
        }
       }
      ]
     }
    ]
