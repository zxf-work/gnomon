        "arith": "+",
        "l": {
         "arith": "+",
         "l": {
          "arith": "*",
          "l": {
           "lit": 12
          },
          "r": {
           "arith": "-",
           "l": {
            "calendar": "year",
            "arg": {
             "lit": "$endDate",
             "tau": "ts"
            }
           },
           "r": {
            "calendar": "year",
            "arg": {
             "col": "p.vt_s"
            }
           }
          }
         },
         "r": {
          "arith": "-",
          "l": {
           "calendar": "month",
           "arg": {
            "lit": "$endDate",
            "tau": "ts"
           }
          },
          "r": {
           "calendar": "month",
           "arg": {
            "col": "p.vt_s"
           }
          }
         }
        },
        "r": {
         "lit": 1
        }
       }
      }
     ],
     "aggs": [
      {
       "as": "messageCount",
       "fn": "count",
       "of": {
        "col": "m.uid"
       }
      }
     ],
     "having": {
      "cmp": "<",
      "l": {
       "col": "messageCount"
      },
      "r": {
       "col": "months"
      }
     }
    }
   },
   "scope": {
    "vt": {
     "instant": "$now"
    }
   },
   "params": {
    "country": {
     "pick": [
      "countries",
      0
     ]
    },
    "endDate": {
     "date": "2012-06-01"
    }
